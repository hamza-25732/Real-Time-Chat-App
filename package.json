{
  "name": "real-time-chat-app",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time chat application built on the MERN stack with Socket.IO",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,magenta --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
