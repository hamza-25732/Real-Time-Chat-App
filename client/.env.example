# URL of the chat backend (Express + Socket.IO).
# Must be VITE_-prefixed to be exposed to the browser — never put secrets here.
VITE_SERVER_URL=http://localhost:5000

# Sub-path the app is served from. GitHub Pages project sites live at
# https://<user>.github.io/<repo>/ so this must be "/<repo>/" for those.
# Read at build time by vite.config.ts; leave unset for local dev.
VITE_BASE_PATH=/
