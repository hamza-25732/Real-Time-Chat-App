# Server. Render sets PORT itself — do not hardcode it there.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chat-app?retryWrites=true&w=majority

# Origins allowed by CORS, comma-separated. In production this is the deployed
# frontend, e.g. https://<user>.github.io. localhost:5173 and 127.0.0.1:5173 are
# always allowed on top of whatever is listed here, so local dev needs no change.
CLIENT_ORIGIN=http://localhost:5173

# Cost factor for bcrypt password hashing
BCRYPT_SALT_ROUNDS=12

# Signing key for session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Gemini, powering the private "AI Assistant" mode.
# Without a key the app still runs; AI mode reports itself as unavailable.
GEMINI_API_KEY=
# gemini-1.5-flash and gemini-2.5-flash are no longer available to new keys.
GEMINI_MODEL=gemini-3.6-flash
